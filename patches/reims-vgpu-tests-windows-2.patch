+/// CPU time in nanoseconds on Windows: this thread's and the process's (kernel plus user time),
+/// and the monotonic clock's (the performance counter), in the order of the Unix form below.
+#[cfg(windows)]
+fn cpu_now() -> [u64; 3] {
+    use windows_sys::Win32::Foundation::FILETIME;
+    use windows_sys::Win32::System::Performance::{QueryPerformanceCounter, QueryPerformanceFrequency};
+    use windows_sys::Win32::System::Threading::{
+        GetCurrentProcess, GetCurrentThread, GetProcessTimes, GetThreadTimes,
+    };
+    // FILETIME counts units of 100 ns.
+    fn ticks(t: FILETIME) -> u64 {
+        ((u64::from(t.dwHighDateTime) << 32) | u64::from(t.dwLowDateTime)) * 100
+    }
+    fn zero() -> FILETIME {
+        FILETIME {
+            dwLowDateTime: 0,
+            dwHighDateTime: 0,
+        }
+    }
+    let (mut c, mut e, mut k, mut u) = (zero(), zero(), zero(), zero());
+    // SAFETY: the pseudo-handle is this thread's; the out-parameters are writable.
+    unsafe { GetThreadTimes(GetCurrentThread(), &mut c, &mut e, &mut k, &mut u) };
+    let thread = ticks(k) + ticks(u);
+    let (mut c, mut e, mut k, mut u) = (zero(), zero(), zero(), zero());
+    // SAFETY: the pseudo-handle is this process's; the out-parameters are writable.
+    unsafe { GetProcessTimes(GetCurrentProcess(), &mut c, &mut e, &mut k, &mut u) };
+    let process = ticks(k) + ticks(u);
+    let (mut count, mut freq) = (0i64, 0i64);
+    // SAFETY: both out-parameters are writable.
+    unsafe {
+        QueryPerformanceCounter(&mut count);
+        QueryPerformanceFrequency(&mut freq);
+    }
+    let wall = (count as u128 * 1_000_000_000 / freq.max(1) as u128) as u64;
+    [thread, process, wall]
+}
