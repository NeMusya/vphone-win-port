+// ---- test helpers (the Linux and macOS layers have the same three) ----
+
+#[cfg(test)]
+use windows_sys::Win32::System::Memory::{PAGE_EXECUTE_READWRITE, PAGE_EXECUTE_WRITECOPY, PAGE_WRITECOPY};
+
+/// The host's page, which the tests lay their pages out by.
+#[cfg(test)]
+pub(crate) const PAGE: u64 = 0x1000;
+
+/// Whether `check` holds for the region of every page run in `[addr, addr + len)`, as
+/// `VirtualQuery` reports the regions now.
+#[cfg(test)]
+fn every_region(addr: u64, len: u64, check: impl Fn(&MEMORY_BASIC_INFORMATION) -> bool) -> bool {
+    let end = addr + len;
+    let mut at = addr;
+    while at < end {
+        let mut mbi: MEMORY_BASIC_INFORMATION = unsafe { std::mem::zeroed() };
+        // SAFETY: a writable MEMORY_BASIC_INFORMATION of the size passed.
+        let got = unsafe {
+            VirtualQuery(
+                at as usize as *const c_void,
+                &mut mbi,
+                std::mem::size_of::<MEMORY_BASIC_INFORMATION>(),
+            )
+        };
+        if got == 0 || !check(&mbi) {
+            return false;
+        }
+        let region_end = mbi.BaseAddress as usize as u64 + mbi.RegionSize as u64;
+        if region_end <= at {
+            return false;
+        }
+        at = region_end;
+    }
+    true
+}
+
+/// Whether every page of `len` bytes from `at` is writable now: committed, with write access.
+/// Like the Linux form, it reads the current protection, so a page lowered to read refuses.
+#[cfg(test)]
+pub(crate) fn writable(at: HostAddr, len: u64) -> bool {
+    const WRITABLE: [u32; 4] = [
+        PAGE_READWRITE,
+        PAGE_WRITECOPY,
+        PAGE_EXECUTE_READWRITE,
+        PAGE_EXECUTE_WRITECOPY,
+    ];
+    every_region(at.addr() as u64, len, |m| {
+        m.State == MEM_COMMIT && WRITABLE.contains(&m.Protect)
+    })
+}
+
+/// Whether the page at `at` is mapped: committed. A freed page is a placeholder, reserved but not
+/// committed, so it is not.
+#[cfg(test)]
+pub(crate) fn mapped(at: HostAddr) -> bool {
+    every_region(at.addr() as u64 & !(PAGE - 1), PAGE, |m| m.State == MEM_COMMIT)
+}
