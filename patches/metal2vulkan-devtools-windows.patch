+
+/// Windows has no device-and-inode pair in std, so this answers by the path alone: whether a file
+/// still has that name. An unlink is caught; a rename to another name and back is not. It only
+/// serves the tests (this crate is a dev-dependency), which never rename the lock they check.
+#[cfg(not(unix))]
+fn same_file(_held: &File, path: &Path) -> io::Result<bool> {
+    match std::fs::metadata(path) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
 }
 
