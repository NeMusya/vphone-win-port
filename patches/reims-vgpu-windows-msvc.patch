@@ -0,0 +1,68 @@
+//! The window backend on Windows: a **compile-only scaffold**.
+//!
+//! The types and functions the window handle and the screen list need are here, so the crate
+//! type-checks for Windows. Nothing opens a window: `open` stops the process with a message, the
+//! screen list is empty, and the clock is real. A Windows window (SDL3 or Win32 with
+//! `VK_KHR_win32_surface`) is not written yet.
+
+use std::sync::Arc;
+
+use reims_vgpu_core::platform::os::{Clock as _, MonoTime};
+use reims_vgpu_vulkan::os::OsClock;
+
+use crate::handle::Window;
+use crate::present::{Presenter, VulkanTarget};
+use crate::screens::HostScreen;
+
+/// A guest frame's destination, as the Linux and macOS backends define it.
+pub trait FrameSink: Send + Sync {
+    /// A presenter for the window's Vulkan target, made at the first draw.
+    fn presenter(&self, target: &dyn VulkanTarget) -> Option<Box<dyn Presenter>>;
+
+    /// Where the guest's cursor is, in the frame, when the guest draws it.
+    fn guest_cursor_position(&self) -> Option<(u16, u16)> {
+        None
+    }
+}
+
+/// A window's surface flags: the scaffold has no presentation, so these only record requests.
+#[derive(Debug, Default)]
+pub(crate) struct Surface;
+
+impl Surface {
+    /// An empty surface: no window, no layout, not shown.
+    pub(crate) fn new() -> Surface {
+        Surface
+    }
+
+    /// A draw was requested. Nothing is drawn by the scaffold.
+    pub(crate) fn request_draw(&self) {}
+
+    /// The window closed. Nothing to tear down in the scaffold.
+    pub(crate) fn close(&self) {}
+}
+
+fn missing(what: &str) -> ! {
+    panic!("reims-vgpu window on Windows: {what} is not implemented yet (compile-only scaffold)")
+}
+
+/// Opening a window is not written for Windows yet.
+pub(crate) fn open(_window: &Arc<Window>) {
+    missing("opening a window")
+}
+
+pub(crate) fn guest_mode_changed(_id: u64) {}
+
+pub(crate) fn cursor_changed(_id: u64) {}
+
+pub(crate) fn close(_id: u64) {}
+
+/// The monotonic clock the window's timings use: the same one the Vulkan platform reads.
+pub(crate) fn now() -> MonoTime {
+    OsClock::new().now_mono()
+}
+
+/// The host's screens: none are listed until a Windows screen query is written.
+pub(crate) fn host_screens() -> Vec<HostScreen> {
+    Vec::new()
+}
