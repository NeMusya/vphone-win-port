+
+mod vm;
+pub(crate) use vm::{allocate_aliasable, allocate_zeros};
+use crate::platform::VulkanPlatform;
+
+/// Stops the process: the named service is not written for Windows yet.
+fn missing(what: &str) -> ! {
+    panic!("reims-vgpu on Windows: {what} is not implemented yet (compile-only scaffold)")
+}
+
+// ---- clocks -------------------------------------------------------------------------------
+
+fn mono_nanos() -> u64 {
+    static START: OnceLock<Instant> = OnceLock::new();
+    let start = START.get_or_init(Instant::now);
+    u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX)
+}
+
+fn wall_nanos() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .and_then(|d| u64::try_from(d.as_nanos()).ok())
+        .unwrap_or(0)
+}
+
+#[derive(Debug, Default)]
+pub struct WindowsClock;
+
+impl WindowsClock {
+    pub fn new() -> WindowsClock {
+        WindowsClock
+    }
+
+    fn remaining(&self, deadline: Deadline) -> std::time::Duration {
+        match deadline {
+            Deadline::Mono(t) => t.saturating_duration_since(self.now_mono()),
+            Deadline::Wall(t) => t.saturating_duration_since(self.now_wall()),
+        }
+    }
+}
+
+impl Clock for WindowsClock {
+    fn now_mono(&self) -> MonoTime {
+        MonoTime::from_nanos(mono_nanos())
+    }
+
+    fn now_wall(&self) -> WallTime {
+        WallTime::from_nanos(wall_nanos())
+    }
+
+    fn wait_until<T>(
+        &self,
+        cv: &Condvar,
+        g: &mut MutexGuard<'_, T>,
+        deadline: Deadline,
+    ) -> TimedOut {
+        let d = self.remaining(deadline);
+        if d.is_zero() {
+            return TimedOut(true);
+        }
+        let _ = cv.wait_for(g, d);
+        TimedOut(deadline.reached(self))
+    }
+
+    fn wait<T>(&self, cv: &Condvar, g: &mut MutexGuard<'_, T>) {
+        cv.wait(g);
+    }
+
+    fn sleep_until(&self, deadline: Deadline) {
+        let d = self.remaining(deadline);
+        if !d.is_zero() {
+            std::thread::sleep(d);
+        }
+    }
+}
