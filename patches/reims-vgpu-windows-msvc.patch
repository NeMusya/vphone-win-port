+//! The OS services on Windows: a **compile-only scaffold**.
+//!
+//! The clocks ([`WindowsClock`]) and threads ([`WindowsThreads`]) are real. The VM, the surfaces
+//! and the memory import are not written yet: every call into them stops the process with a
+//! message naming it (`missing`), so the rest of the runtime can be type-checked and run far
+//! enough to show what it asks of the host next. Nothing here maps guest memory or imports it
+//! into Vulkan.
+
+use std::ffi::CStr;
+use std::ptr::NonNull;
+use std::sync::{Arc, OnceLock};
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::host::HostPtr;
+use reims_vgpu_core::platform::Handle;
